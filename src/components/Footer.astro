---
import { profile } from "../data/profile";

const currentYear = new Date().getFullYear();
---

<footer class="mt-24 border-t border-line bg-surface/60">
  <div class="mx-auto max-w-5xl px-6 py-14">
    <div class="grid grid-cols-1 gap-10 md:grid-cols-12">
      <!-- Identity -->
      <div class="md:col-span-5">
        <div class="flex items-center gap-2.5">
          <img
            src="/assets/brand/logo-dc.png"
            alt="Diego Chacón logo"
            width="24"
            height="24"
            class="h-6 w-6 object-contain"
          />
          <span class="font-display text-base font-semibold uppercase tracking-[0.06em] text-ink">
            {profile.fullName}
          </span>
        </div>
        <p class="mt-3 max-w-sm text-sm leading-relaxed text-muted">
          {profile.role}. {profile.focusLine}.
        </p>
        <p class="mt-2 font-mono text-xs text-metal/75">
          {profile.location} · {profile.workMode}
        </p>
      </div>

      <!-- Navigation -->
      <div class="md:col-span-3">
        <h2 class="font-mono text-xs font-medium uppercase tracking-[0.14em] text-muted">
          Navigation
        </h2>
        <ul class="mt-4 space-y-2.5 text-sm">
          {
            profile.navigation.map((item) => (
              <li>
                <a
                  href={item.href}
                  class="text-metal transition-colors hover:text-accent"
                >
                  {item.label}
                </a>
              </li>
            ))
          }
          <li>
            <a
              href={profile.cvPath}
              download={profile.cvDownloadName}
              class="text-metal transition-colors hover:text-accent"
            >
              Download Resume (PDF)
            </a>
          </li>
        </ul>
      </div>

      <!-- Direct & Socials -->
      <div class="md:col-span-4">
        <h2 class="font-mono text-xs font-medium uppercase tracking-[0.14em] text-muted">
          Connect
        </h2>
        <ul class="mt-4 space-y-2.5 text-sm">
          <li>
            <a
              href={`mailto:${profile.email}`}
              class="font-mono text-xs text-ink underline decoration-line-strong underline-offset-4 transition-colors hover:text-accent hover:decoration-accent"
            >
              {profile.email}
            </a>
          </li>
          {
            profile.socials.map((social) => (
              <li>
                <a
                  href={social.href}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-1.5 text-metal transition-colors hover:text-accent"
                >
                  <span>{social.label}</span>
                  <span class="font-mono text-xs text-muted">↗</span>
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    <div class="mt-12 flex flex-col items-start justify-between gap-3 border-t border-line pt-6 font-mono text-xs text-muted sm:flex-row sm:items-center">
      <p>© {currentYear} {profile.name} // Built with Astro & Tailwind CSS.</p>
      <p class="text-metal/60">Zero bloat · Static-first</p>
    </div>
  </div>
</footer>
