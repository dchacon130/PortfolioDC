---
interface Props {
  index: string;
  label: string;
  title?: string;
  subtitle?: string;
}

const { index, label, title, subtitle } = Astro.props;
---

<div class="mb-10">
  <p class="font-mono text-xs uppercase tracking-[0.16em] text-muted">
    <span class="text-accent">{index}</span> // {label}
  </p>
  {
    title && (
      <h2 class="mt-2 font-display text-3xl font-semibold uppercase tracking-[0.02em] text-ink sm:text-4xl">
        {title}
      </h2>
    )
  }
  {
    subtitle && (
      <p class="mt-3 max-w-2xl text-base leading-relaxed text-muted">
        {subtitle}
      </p>
    )
  }
</div>
