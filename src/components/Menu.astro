---
import { getProfile } from "../data/profile";
import { getUiCopy } from "../i18n/ui";
import {
  getAlternatePath,
  getLocalizedPath,
  normalizePath,
  type Locale,
} from "../i18n/utils";

interface Props {
  locale?: Locale;
}

const { locale = "en" } = Astro.props;
const profile = getProfile(locale);
const ui = getUiCopy(locale);

const currentPath = normalizePath(Astro.url.pathname);
const homeHref = getLocalizedPath("/", locale);
const enHref = getAlternatePath(Astro.url.pathname, "en");
const esHref = getAlternatePath(Astro.url.pathname, "es");

function isActive(href: string): boolean {
  return currentPath === normalizePath(href);
}
---

<header class="sticky top-0 z-50 border-b border-line bg-paper/90 backdrop-blur-md">
  <!-- Thin molten accent hairline -->
  <div class="h-[2px] w-full bg-gradient-to-r from-accent via-accent/40 to-transparent" aria-hidden="true"></div>

  <div class="mx-auto flex h-16 max-w-5xl items-center justify-between px-6">
    <!-- Brand Mark -->
    <a
      href={homeHref}
      class="group flex items-center gap-3 text-ink transition-opacity hover:opacity-90"
      aria-label={`${profile.name} — ${ui.nav.home}`}
    >
      <img
        src="/assets/brand/logo-dc.png"
        alt="Diego Chacón logo"
        width="28"
        height="28"
        class="h-7 w-7 object-contain"
      />
      <span class="font-display text-lg font-semibold uppercase tracking-[0.06em]">
        {profile.name}
      </span>
      <span class="hidden font-mono text-xs text-muted sm:inline">// SDET</span>
    </a>

    <!-- Desktop Navigation -->
    <nav aria-label={ui.nav.primaryLabel} class="hidden items-center gap-5 md:flex">
      <ul class="flex items-center gap-6">
        {
          profile.navigation.map((item) => {
            const active = isActive(item.href);
            return (
              <li>
                <a
                  href={item.href}
                  aria-current={active ? "page" : undefined}
                  class:list={[
                    "relative py-1 font-mono text-xs uppercase tracking-[0.12em] transition-colors",
                    active
                      ? "font-medium text-ink"
                      : "text-muted hover:text-ink",
                  ]}
                >
                  {item.label}
                  {active && (
                    <span
                      aria-hidden="true"
                      class="absolute right-0 -bottom-[22px] left-0 h-[2px] bg-accent"
                    />
                  )}
                </a>
              </li>
            );
          })
        }
      </ul>

      <!-- Utility controls: EN/ES + Theme Toggle -->
      <div class="flex items-center gap-2">
        <div
          role="group"
          aria-label={ui.nav.languageSwitcherLabel}
          class="inline-flex items-center rounded-[2px] border border-line-strong bg-surface p-0.5 font-mono text-[11px] uppercase"
        >
          <a
            href={enHref}
            hreflang="en"
            aria-current={locale === "en" ? "true" : undefined}
            class:list={[
              "rounded-[1px] px-2 py-1 transition-colors",
              locale === "en"
                ? "bg-subtle font-medium text-ink"
                : "text-muted hover:text-ink",
            ]}
          >
            EN
          </a>
          <a
            href={esHref}
            hreflang="es"
            aria-current={locale === "es" ? "true" : undefined}
            class:list={[
              "rounded-[1px] px-2 py-1 transition-colors",
              locale === "es"
                ? "bg-subtle font-medium text-ink"
                : "text-muted hover:text-ink",
            ]}
          >
            ES
          </a>
        </div>

        <button
          type="button"
          data-theme-toggle
          aria-label={ui.nav.themeToggleLabel}
          title={ui.nav.themeToggleLabel}
          class="inline-flex h-[30px] w-[30px] items-center justify-center rounded-[2px] border border-line-strong bg-surface text-metal transition-colors hover:border-accent hover:text-ink cursor-pointer"
        >
          <!-- Sun icon (shown in dark mode to switch to light) -->
          <svg
            data-icon-sun
            xmlns="http://www.w3.org/2000/svg"
            class="h-3.5 w-3.5"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="2"
            aria-hidden="true"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M12 3v2m0 14v2m9-9h-2M5 12H3m15.364 6.364-1.414-1.414M7.05 7.05 5.636 5.636m12.728 0-1.414 1.414M7.05 16.95l-1.414 1.414M16 12a4 4 0 1 1-8 0 4 4 0 0 1 8 0Z"
            />
          </svg>
          <!-- Moon icon (shown in light mode to switch back to dark) -->
          <svg
            data-icon-moon
            xmlns="http://www.w3.org/2000/svg"
            class="hidden h-3.5 w-3.5"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="2"
            aria-hidden="true"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M21 12.79A9 9 0 1 1 11.21 3a7 7 0 0 0 9.79 9.79Z"
            />
          </svg>
        </button>
      </div>

      <a
        href={profile.cvPath}
        download={profile.cvDownloadName}
        class="inline-flex items-center gap-1.5 rounded-[2px] border border-accent bg-accent px-3.5 py-1.5 font-mono text-xs font-medium uppercase tracking-wider text-paper transition-colors hover:border-ink hover:bg-ink"
      >
        <span>{ui.nav.cvShort}</span>
        <svg
          xmlns="http://www.w3.org/2000/svg"
          class="h-3.5 w-3.5"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          stroke-width="2.2"
          aria-hidden="true"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M12 4v12m0 0l-4-4m4 4l4-4M4 20h16"
          />
        </svg>
      </a>
    </nav>

    <!-- Mobile Controls -->
    <div class="flex items-center gap-2 md:hidden">
      <button
        type="button"
        data-theme-toggle
        aria-label={ui.nav.themeToggleLabel}
        class="inline-flex h-9 w-9 items-center justify-center rounded-[2px] border border-line-strong bg-surface text-metal transition-colors hover:border-accent hover:text-ink cursor-pointer"
      >
        <svg
          data-icon-sun
          xmlns="http://www.w3.org/2000/svg"
          class="h-4 w-4"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          stroke-width="2"
          aria-hidden="true"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M12 3v2m0 14v2m9-9h-2M5 12H3m15.364 6.364-1.414-1.414M7.05 7.05 5.636 5.636m12.728 0-1.414 1.414M7.05 16.95l-1.414 1.414M16 12a4 4 0 1 1-8 0 4 4 0 0 1 8 0Z"
          />
        </svg>
        <svg
          data-icon-moon
          xmlns="http://www.w3.org/2000/svg"
          class="hidden h-4 w-4"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          stroke-width="2"
          aria-hidden="true"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M21 12.79A9 9 0 1 1 11.21 3a7 7 0 0 0 9.79 9.79Z"
          />
        </svg>
      </button>

      <button
        id="mobile-menu-button"
        type="button"
        class="inline-flex items-center justify-center rounded-[2px] border border-line-strong bg-surface p-2 text-ink transition-colors hover:border-accent"
        aria-label={ui.nav.toggleMenu}
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <svg
          id="menu-icon-open"
          class="h-5 w-5"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          stroke-width="1.75"
          aria-hidden="true"
        >
          <path stroke-linecap="round" stroke-linejoin="round" d="M4 7h16M4 12h16M4 17h16" />
        </svg>
        <svg
          id="menu-icon-close"
          class="hidden h-5 w-5"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          stroke-width="1.75"
          aria-hidden="true"
        >
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Navigation Drawer -->
  <div
    id="mobile-menu"
    class="hidden border-t border-line bg-surface px-6 py-5 md:hidden"
  >
    <nav aria-label={ui.nav.mobileLabel} class="flex flex-col gap-1">
      {
        profile.navigation.map((item) => {
          const active = isActive(item.href);
          return (
            <a
              href={item.href}
              aria-current={active ? "page" : undefined}
              class:list={[
                "flex items-center justify-between rounded-[2px] px-2.5 py-2.5 font-mono text-xs uppercase tracking-[0.12em] transition-colors",
                active
                  ? "bg-subtle font-medium text-ink"
                  : "text-muted hover:bg-subtle/60 hover:text-ink",
              ]}
            >
              <span>{item.label}</span>
              {active && <span class="h-1.5 w-1.5 bg-accent" />}
            </a>
          );
        })
      }

      <!-- Mobile Language Switcher -->
      <div class="mt-3 flex items-center justify-between border-t border-line pt-4">
        <span class="font-mono text-[11px] uppercase tracking-wider text-muted">
          {ui.nav.languageSwitcherLabel}
        </span>
        <div
          role="group"
          aria-label={ui.nav.languageSwitcherLabel}
          class="inline-flex items-center rounded-[2px] border border-line-strong bg-paper p-0.5 font-mono text-xs uppercase"
        >
          <a
            href={enHref}
            hreflang="en"
            aria-current={locale === "en" ? "true" : undefined}
            class:list={[
              "rounded-[1px] px-2.5 py-1 transition-colors",
              locale === "en"
                ? "bg-subtle font-medium text-ink"
                : "text-muted hover:text-ink",
            ]}
          >
            EN
          </a>
          <a
            href={esHref}
            hreflang="es"
            aria-current={locale === "es" ? "true" : undefined}
            class:list={[
              "rounded-[1px] px-2.5 py-1 transition-colors",
              locale === "es"
                ? "bg-subtle font-medium text-ink"
                : "text-muted hover:text-ink",
            ]}
          >
            ES
          </a>
        </div>
      </div>

      <div class="mt-3 border-t border-line pt-4">
        <a
          href={profile.cvPath}
          download={profile.cvDownloadName}
          class="flex w-full items-center justify-center gap-2 rounded-[2px] bg-accent px-4 py-2.5 font-mono text-xs font-medium uppercase tracking-wider text-paper transition-colors hover:bg-ink"
        >
          <span>{ui.nav.cvDownloadFull}</span>
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="h-3.5 w-3.5"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="2.2"
            aria-hidden="true"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M12 4v12m0 0l-4-4m4 4l4-4M4 20h16"
            />
          </svg>
        </a>
      </div>
    </nav>
  </div>
</header>

<script>
  const button = document.getElementById("mobile-menu-button");
  const menu = document.getElementById("mobile-menu");
  const iconOpen = document.getElementById("menu-icon-open");
  const iconClose = document.getElementById("menu-icon-close");

  function setMenuOpen(open: boolean) {
    if (!button || !menu) return;
    menu.classList.toggle("hidden", !open);
    iconOpen?.classList.toggle("hidden", open);
    iconClose?.classList.toggle("hidden", !open);
    button.setAttribute("aria-expanded", String(open));
  }

  button?.addEventListener("click", () => {
    const isOpen = button.getAttribute("aria-expanded") === "true";
    setMenuOpen(!isOpen);
  });

  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape") setMenuOpen(false);
  });

  window.addEventListener("resize", () => {
    if (window.innerWidth >= 768) setMenuOpen(false);
  });

  // Theme toggle (Heavy Metal Dark default <-> Brushed Steel Light)
  const themeButtons = document.querySelectorAll<HTMLButtonElement>("[data-theme-toggle]");

  function syncThemeUI(theme: "dark" | "light") {
    document.documentElement.dataset.theme = theme;
    const meta = document.querySelector('meta[name="theme-color"]');
    if (meta) meta.setAttribute("content", theme === "light" ? "#ECECEE" : "#0B0B0C");

    themeButtons.forEach((btn) => {
      btn.setAttribute("aria-pressed", String(theme === "light"));
      btn.querySelector("[data-icon-sun]")?.classList.toggle("hidden", theme === "light");
      btn.querySelector("[data-icon-moon]")?.classList.toggle("hidden", theme === "dark");
    });
  }

  const initialTheme = document.documentElement.dataset.theme === "light" ? "light" : "dark";
  syncThemeUI(initialTheme);

  themeButtons.forEach((btn) => {
    btn.addEventListener("click", () => {
      const next = document.documentElement.dataset.theme === "light" ? "dark" : "light";
      try {
        localStorage.setItem("portfolio-theme", next);
      } catch {}
      syncThemeUI(next);
    });
  });
</script>
