---
import Layout from "../layouts/Layout.astro";
import { getProfile } from "../data/profile";
import { getUiCopy } from "../i18n/ui";
import type { Locale } from "../i18n/utils";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const profile = getProfile(locale);
const ui = getUiCopy(locale);
---

<Layout
  locale={locale}
  title={ui.contact.seoTitle}
  description={ui.contact.seoDescription}
>
  <!-- Page Header -->
  <section class="mx-auto max-w-5xl px-6 pt-16 pb-12 sm:pt-20">
    <div class="reveal">
      <p class="font-mono text-xs uppercase tracking-[0.16em] text-muted">
        <span class="text-accent">{ui.contact.eyebrowTag}</span> // {ui.contact.eyebrowSub}
      </p>
      <h1 class="mt-3 max-w-3xl font-display text-4xl font-bold uppercase tracking-[0.015em] text-ink sm:text-5xl lg:text-6xl">
        {ui.contact.title}
      </h1>
      <p class="mt-4 max-w-2xl text-base leading-relaxed text-metal">
        {ui.contact.subtitle}
      </p>
    </div>
  </section>

  <!-- Main Grid -->
  <section class="mx-auto max-w-5xl px-6 py-8">
    <div class="grid grid-cols-1 gap-10 border-t border-line pt-12 md:grid-cols-12">
      <!-- Direct Channels -->
      <div class="space-y-8 md:col-span-5">
        <div>
          <h2 class="font-mono text-xs font-medium uppercase tracking-[0.14em] text-muted">
            {ui.contact.directEmail}
          </h2>
          <div class="mt-2 flex flex-wrap items-center gap-3">
            <a
              href={`mailto:${profile.email}`}
              class="font-mono text-base font-medium text-ink underline decoration-line-strong underline-offset-4 transition-colors hover:text-accent hover:decoration-accent"
            >
              {profile.email}
            </a>
            <button
              id="copy-email-btn"
              type="button"
              data-email={profile.email}
              data-label-copy={ui.contact.copy}
              data-label-copied={ui.contact.copied}
              data-label-failed={ui.contact.copyFailed}
              class="rounded-[2px] border border-line-strong bg-surface px-2.5 py-1 font-mono text-[11px] uppercase tracking-wider text-metal transition-colors hover:border-accent hover:text-ink cursor-pointer"
            >
              {ui.contact.copy}
            </button>
          </div>
        </div>

        <div>
          <h2 class="font-mono text-xs font-medium uppercase tracking-[0.14em] text-muted">
            {ui.contact.locationTimezone}
          </h2>
          <p class="mt-2 text-sm text-ink">{profile.location}</p>
          <p class="mt-0.5 font-mono text-xs text-muted">{profile.workMode}</p>
        </div>

        <div>
          <h2 class="font-mono text-xs font-medium uppercase tracking-[0.14em] text-muted">
            {ui.contact.profiles}
          </h2>
          <ul class="mt-3 divide-y divide-line border-y border-line">
            {
              profile.socials.map((social) => (
                <li>
                  <a
                    href={social.href}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="flex items-center justify-between py-3 text-sm transition-colors hover:text-accent"
                  >
                    <span class="font-medium text-ink">{social.label}</span>
                    <span class="font-mono text-xs text-muted">
                      {social.handle} ↗
                    </span>
                  </a>
                </li>
              ))
            }
          </ul>
        </div>

        <div>
          <a
            href={profile.cvPath}
            download={profile.cvDownloadName}
            class="inline-flex items-center gap-2 rounded-[2px] border border-line-strong bg-surface px-4 py-2.5 font-mono text-xs font-medium uppercase tracking-wider text-ink transition-colors hover:border-accent"
          >
            <span>{ui.contact.downloadResume}</span>
            <span aria-hidden="true">↓</span>
          </a>
        </div>
      </div>

      <!-- Contact Form -->
      <div class="md:col-span-7">
        <div class="rounded-[2px] border border-line-strong border-t-2 border-t-accent bg-surface p-6 sm:p-8">
          <h2 class="font-display text-2xl font-semibold uppercase tracking-[0.02em] text-ink">
            {ui.contact.formTitle}
          </h2>
          <p class="mt-1 text-sm text-muted">
            {ui.contact.formSubtitle}
          </p>

          <form
            id="contact-form"
            data-endpoint={profile.contactFormEndpoint}
            data-email={profile.email}
            data-label-submit={ui.contact.submitButton}
            data-label-sending={ui.contact.sendingButton}
            data-msg-mailto={ui.contact.statusMailtoPrefix}
            data-msg-success={ui.contact.statusSuccess}
            data-msg-submit-error={ui.contact.statusSubmitError}
            data-msg-network-error={ui.contact.statusNetworkError}
            class="mt-6 space-y-5"
          >
            <!-- Honeypot spam trap -->
            <input
              type="text"
              name="_gotcha"
              tabindex="-1"
              autocomplete="off"
              class="hidden"
            />

            <div>
              <label
                for="name"
                class="block font-mono text-xs font-medium uppercase tracking-[0.12em] text-metal"
              >
                {ui.contact.nameLabel}
              </label>
              <input
                type="text"
                id="name"
                name="name"
                autocomplete="name"
                required
                placeholder={ui.contact.namePlaceholder}
                class="mt-2 w-full rounded-[2px] border border-line-strong bg-paper px-3.5 py-2.5 text-sm text-ink placeholder:text-muted/60 focus:border-accent focus:outline-none"
              />
            </div>

            <div>
              <label
                for="email"
                class="block font-mono text-xs font-medium uppercase tracking-[0.12em] text-metal"
              >
                {ui.contact.emailLabel}
              </label>
              <input
                type="email"
                id="email"
                name="email"
                autocomplete="email"
                required
                placeholder={ui.contact.emailPlaceholder}
                class="mt-2 w-full rounded-[2px] border border-line-strong bg-paper px-3.5 py-2.5 text-sm text-ink placeholder:text-muted/60 focus:border-accent focus:outline-none"
              />
            </div>

            <div>
              <label
                for="message"
                class="block font-mono text-xs font-medium uppercase tracking-[0.12em] text-metal"
              >
                {ui.contact.messageLabel}
              </label>
              <textarea
                id="message"
                name="message"
                rows="5"
                required
                placeholder={ui.contact.messagePlaceholder}
                class="mt-2 w-full rounded-[2px] border border-line-strong bg-paper px-3.5 py-2.5 text-sm text-ink placeholder:text-muted/60 focus:border-accent focus:outline-none"
              ></textarea>
            </div>

            <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
              <button
                id="submit-btn"
                type="submit"
                class="inline-flex items-center justify-center gap-2 rounded-[2px] bg-accent px-6 py-2.5 font-mono text-xs font-medium uppercase tracking-wider text-paper transition-colors hover:bg-ink disabled:cursor-not-allowed disabled:opacity-60 cursor-pointer"
              >
                <span id="submit-btn-label">{ui.contact.submitButton}</span>
                <span aria-hidden="true">→</span>
              </button>
              <p class="font-mono text-[11px] text-muted">
                {ui.contact.noSpam}
              </p>
            </div>

            <p
              id="form-status"
              role="status"
              aria-live="polite"
              class="hidden rounded-[2px] border border-line-strong bg-subtle px-4 py-3 text-xs leading-relaxed text-ink"
            ></p>
          </form>
        </div>
      </div>
    </div>
  </section>
</Layout>

<script>
  const copyBtn = document.getElementById("copy-email-btn") as HTMLButtonElement | null;
  copyBtn?.addEventListener("click", async () => {
    const email = copyBtn.dataset.email || "";
    const copyLabel = copyBtn.dataset.labelCopy || "Copy";
    const copiedLabel = copyBtn.dataset.labelCopied || "Copied";
    const failedLabel = copyBtn.dataset.labelFailed || "Failed";
    try {
      await navigator.clipboard.writeText(email);
      copyBtn.textContent = copiedLabel;
      setTimeout(() => {
        copyBtn.textContent = copyLabel;
      }, 2000);
    } catch {
      copyBtn.textContent = failedLabel;
    }
  });

  const form = document.getElementById("contact-form") as HTMLFormElement | null;
  const submitBtn = document.getElementById("submit-btn") as HTMLButtonElement | null;
  const submitBtnLabel = document.getElementById("submit-btn-label");
  const statusEl = document.getElementById("form-status");

  function showStatus(message: string, variant: "success" | "error" | "info" = "info") {
    if (!statusEl) return;
    statusEl.textContent = message;
    statusEl.classList.remove(
      "hidden",
      "border-red-500/40",
      "bg-red-950/60",
      "text-red-200",
      "border-emerald-500/40",
      "bg-emerald-950/50",
      "text-emerald-200",
      "border-line-strong",
      "bg-subtle",
      "text-ink"
    );
    if (variant === "error") {
      statusEl.classList.add("border-red-500/40", "bg-red-950/60", "text-red-200");
    } else if (variant === "success") {
      statusEl.classList.add("border-emerald-500/40", "bg-emerald-950/50", "text-emerald-200");
    } else {
      statusEl.classList.add("border-line-strong", "bg-subtle", "text-ink");
    }
  }

  form?.addEventListener("submit", async (event) => {
    event.preventDefault();
    const formData = new FormData(form);
    if (formData.get("_gotcha")) return;

    const name = String(formData.get("name") || "").trim();
    const email = String(formData.get("email") || "").trim();
    const message = String(formData.get("message") || "").trim();
    const endpoint = (form.dataset.endpoint || "").trim();
    const targetEmail = (form.dataset.email || "").trim();

    const labelSubmit = form.dataset.labelSubmit || "Send message";
    const labelSending = form.dataset.labelSending || "Sending...";
    const msgMailto = form.dataset.msgMailto || "Opening your email app to send this message to";
    const msgSuccess = form.dataset.msgSuccess || "Message sent. Thank you for reaching out.";
    const msgSubmitError = form.dataset.msgSubmitError || "Could not submit via form right now. Please email";
    const msgNetworkError = form.dataset.msgNetworkError || "Network error while sending. Please email";

    if (!endpoint) {
      const subject = encodeURIComponent(`Portfolio Inquiry from ${name}`);
      const body = encodeURIComponent(`Name: ${name}\nEmail: ${email}\n\n${message}`);
      window.location.href = `mailto:${targetEmail}?subject=${subject}&body=${body}`;
      showStatus(`${msgMailto} ${targetEmail}.`, "info");
      return;
    }

    if (submitBtn) submitBtn.disabled = true;
    if (submitBtnLabel) submitBtnLabel.textContent = labelSending;

    try {
      const response = await fetch(endpoint, {
        method: "POST",
        headers: {
          "Content-Type": "application/json",
          Accept: "application/json",
        },
        body: JSON.stringify({
          name,
          email,
          message,
          _subject: `Portfolio Inquiry from ${name}`,
        }),
      });

      if (response.ok) {
        form.reset();
        showStatus(msgSuccess, "success");
        return;
      }

      let errorDetail = "";
      try {
        const payload = await response.json();
        if (typeof payload?.error === "string") {
          errorDetail = payload.error;
        } else if (Array.isArray(payload?.errors) && payload.errors.length > 0) {
          errorDetail = payload.errors
            .map((item: { message?: string }) => item.message)
            .filter(Boolean)
            .join(", ");
        }
      } catch {
        // Ignore non-JSON error bodies
      }

      const detailSuffix = errorDetail ? ` (${errorDetail})` : "";
      showStatus(`${msgSubmitError} ${targetEmail}.${detailSuffix}`, "error");
    } catch {
      showStatus(`${msgNetworkError} ${targetEmail}.`, "error");
    } finally {
      if (submitBtn) submitBtn.disabled = false;
      if (submitBtnLabel) submitBtnLabel.textContent = labelSubmit;
    }
  });
</script>
