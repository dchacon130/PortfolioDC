---
import Layout from "../layouts/Layout.astro";
import { getServices } from "../data/services";
import { getProfile } from "../data/profile";
import { getUiCopy } from "../i18n/ui";
import { getLocalizedPath, type Locale } from "../i18n/utils";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const profile = getProfile(locale);
const ui = getUiCopy(locale);
const services = getServices(locale);
const contactHref = getLocalizedPath("/contact", locale);
---

<Layout
  locale={locale}
  title={ui.services.seoTitle}
  description={ui.services.seoDescription}
>
  <!-- Page Header -->
  <section class="mx-auto max-w-5xl px-6 pt-16 pb-12 sm:pt-20">
    <div class="reveal">
      <p class="font-mono text-xs uppercase tracking-[0.16em] text-muted">
        <span class="text-accent">{ui.services.eyebrowTag}</span> // {ui.services.eyebrowSub}
      </p>
      <h1 class="mt-3 max-w-3xl font-display text-4xl font-bold uppercase tracking-[0.015em] text-ink sm:text-5xl lg:text-6xl">
        {ui.services.title}
      </h1>
      <p class="mt-4 max-w-2xl text-base leading-relaxed text-metal">
        {ui.services.subtitle}
      </p>
    </div>
  </section>

  <!-- Service Offerings -->
  <section class="mx-auto max-w-5xl px-6 py-8">
    <div class="divide-y divide-line border-y border-line">
      {
        services.map((service) => (
          <article class="grid grid-cols-1 gap-8 py-12 md:grid-cols-12">
            <div class="md:col-span-4">
              <p class="font-mono text-xs font-medium text-accent">
                {service.index} //
              </p>
              <h2 class="mt-2 font-display text-2xl font-semibold uppercase tracking-[0.02em] text-ink sm:text-3xl">
                {service.title}
              </h2>
              <div class="mt-4 flex flex-wrap gap-1.5">
                {service.tools.map((tool) => (
                  <span class="rounded-[2px] border border-line bg-subtle px-2.5 py-0.5 font-mono text-[11px] text-metal">
                    {tool}
                  </span>
                ))}
              </div>
            </div>

            <div class="md:col-span-8">
              <p class="text-base leading-relaxed text-ink">
                {service.summary}
              </p>

              <h3 class="mt-6 font-mono text-[11px] font-medium uppercase tracking-[0.14em] text-muted">
                {ui.services.deliverablesLabel}
              </h3>
              <ul class="mt-3 space-y-2.5 text-sm leading-relaxed text-muted">
                {service.deliverables.map((item) => (
                  <li class="flex gap-2.5">
                    <span class="mt-2 h-1.5 w-1.5 shrink-0 bg-accent" />
                    <span>{item}</span>
                  </li>
                ))}
              </ul>
            </div>
          </article>
        ))
      }
    </div>
  </section>

  <!-- CTA -->
  <section class="mx-auto max-w-5xl px-6 pt-12">
    <div class="flex flex-col justify-between gap-6 rounded-[2px] border border-line-strong border-l-2 border-l-accent bg-surface p-8 sm:p-10 md:flex-row md:items-center">
      <div>
        <p class="font-mono text-xs uppercase tracking-[0.16em] text-accent">
          {ui.services.ctaEyebrow}
        </p>
        <h2 class="mt-2 font-display text-2xl font-semibold uppercase tracking-[0.02em] text-ink sm:text-3xl">
          {ui.services.ctaTitle}
        </h2>
        <p class="mt-2 max-w-xl text-sm leading-relaxed text-muted">
          {ui.services.ctaSubtitle}
        </p>
      </div>
      <div class="flex shrink-0 flex-wrap gap-3">
        <a
          href={contactHref}
          class="inline-flex items-center gap-2 rounded-[2px] bg-accent px-5 py-2.5 font-mono text-xs font-medium uppercase tracking-wider text-paper transition-colors hover:bg-ink"
        >
          <span>{ui.services.ctaButton}</span>
          <span aria-hidden="true">→</span>
        </a>
        <a
          href={`mailto:${profile.email}`}
          class="inline-flex items-center rounded-[2px] border border-line-strong px-4 py-2.5 font-mono text-xs text-metal transition-colors hover:border-metal hover:text-ink"
        >
          {ui.services.emailDirectly}
        </a>
      </div>
    </div>
  </section>
</Layout>
