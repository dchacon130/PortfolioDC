---
import Layout from "../layouts/Layout.astro";
import SectionHeader from "../components/SectionHeader.astro";
import { profile } from "../data/profile";
import { caseStudies } from "../data/projects";
import { services } from "../data/services";

const featuredWork = caseStudies.filter((item) => item.featured);
---

<Layout>
  <!-- Hero -->
  <section class="mx-auto max-w-5xl px-6 pt-16 pb-16 sm:pt-24 sm:pb-20">
    <div class="reveal">
      {
        profile.availability.active && (
          <div class="mb-7 inline-flex items-center gap-2.5 rounded-[2px] border border-line-strong bg-surface px-3.5 py-1.5 font-mono text-xs text-metal">
            <span class="relative flex h-2 w-2">
              <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-accent opacity-70" />
              <span class="relative inline-flex h-2 w-2 rounded-full bg-accent" />
            </span>
            <span>{profile.availability.label}</span>
          </div>
        )
      }

      <p class="font-mono text-xs uppercase tracking-[0.16em] text-muted">
        {profile.hero.eyebrow}
      </p>

      <h1 class="mt-4 max-w-4xl font-display text-4xl font-bold uppercase tracking-[0.015em] text-ink sm:text-6xl lg:text-[4.15rem] lg:leading-[1.03]">
        {profile.hero.headline}
      </h1>

      <p class="mt-6 max-w-2xl text-base leading-relaxed text-metal sm:text-lg">
        {profile.hero.summary}
      </p>

      <div class="mt-9 flex flex-wrap items-center gap-4">
        <a
          href="/contact"
          class="inline-flex items-center gap-2 rounded-[2px] bg-accent px-6 py-3 font-mono text-xs font-medium uppercase tracking-wider text-paper transition-colors hover:bg-ink"
        >
          <span>Start a conversation</span>
          <span aria-hidden="true">→</span>
        </a>
        <a
          href="/portfolio"
          class="inline-flex items-center gap-2 rounded-[2px] border border-line-strong bg-surface px-6 py-3 font-mono text-xs font-medium uppercase tracking-wider text-ink transition-colors hover:border-metal"
        >
          <span>Selected work</span>
        </a>
        <a
          href={profile.cvPath}
          download={profile.cvDownloadName}
          class="px-2 py-2 font-mono text-xs uppercase tracking-wider text-muted underline decoration-line-strong underline-offset-4 transition-colors hover:text-accent hover:decoration-accent"
        >
          Download CV (PDF)
        </a>
      </div>
    </div>
  </section>

  <!-- Proof Metrics Strip -->
  <section aria-label="Key career metrics" class="border-y border-line bg-surface">
    <div class="mx-auto grid max-w-5xl grid-cols-2 divide-x divide-y divide-line px-6 md:grid-cols-4 md:divide-y-0">
      {
        profile.metrics.map((metric, idx) => (
          <div
            class:list={[
              "py-7",
              idx === 0 ? "pr-6" : "px-5 md:px-6",
              idx === 2 ? "pl-0 md:pl-6" : "",
            ]}
          >
            <p class="font-display text-3xl font-semibold tracking-wide text-accent sm:text-4xl">
              {metric.value}
            </p>
            <p class="mt-1.5 text-sm font-medium text-ink">{metric.label}</p>
            <p class="mt-1 text-xs leading-relaxed text-muted">{metric.detail}</p>
          </div>
        ))
      }
    </div>
  </section>

  <!-- Selected Case Studies -->
  <section class="mx-auto max-w-5xl px-6 pt-20 sm:pt-24">
    <div class="flex flex-col justify-between gap-4 sm:flex-row sm:items-end">
      <SectionHeader
        index="01"
        label="Selected Work"
        title="Production automation & quality engineering"
        subtitle="Recent enterprise systems where I architected multi-platform test frameworks, release gates, and measurable regression pipelines."
      />
      <a
        href="/portfolio"
        class="mb-10 shrink-0 font-mono text-xs uppercase tracking-wider text-metal underline decoration-line-strong underline-offset-4 transition-colors hover:text-accent hover:decoration-accent"
      >
        All case studies →
      </a>
    </div>

    <div class="divide-y divide-line border-y border-line">
      {
        featuredWork.map((project) => (
          <article class="group grid grid-cols-1 gap-6 py-8 md:grid-cols-12 md:gap-8">
            <div class="md:col-span-4">
              <p class="font-mono text-xs text-muted">
                <span class="text-accent">{project.index}</span> // {project.period}
              </p>
              <h3 class="mt-2 font-display text-xl font-semibold uppercase tracking-[0.02em] text-ink">
                <a
                  href={`/portfolio#${project.id}`}
                  class="transition-colors group-hover:text-accent"
                >
                  {project.title}
                </a>
              </h3>
              <p class="mt-1 font-mono text-xs text-muted">{project.category}</p>
              <p class="mt-3 inline-block rounded-[2px] border border-accent/30 bg-accent-soft px-2.5 py-1 font-mono text-xs text-accent">
                {project.metric}
              </p>
            </div>

            <div class="md:col-span-8">
              <p class="text-sm leading-relaxed text-ink sm:text-base">
                {project.summary}
              </p>
              <p class="mt-3 text-sm leading-relaxed text-muted">
                {project.impact}
              </p>
              <div class="mt-4 flex flex-wrap gap-1.5">
                {project.stack.slice(0, 6).map((tech) => (
                  <span class="rounded-[2px] border border-line bg-subtle px-2.5 py-0.5 font-mono text-[11px] text-metal">
                    {tech}
                  </span>
                ))}
              </div>
            </div>
          </article>
        ))
      }
    </div>
  </section>

  <!-- Capabilities Snapshot -->
  <section class="mx-auto max-w-5xl px-6 pt-20 sm:pt-24">
    <div class="flex flex-col justify-between gap-4 sm:flex-row sm:items-end">
      <SectionHeader
        index="02"
        label="How I Help"
        title="Core SDET capabilities"
      />
      <a
        href="/services"
        class="mb-10 shrink-0 font-mono text-xs uppercase tracking-wider text-metal underline decoration-line-strong underline-offset-4 transition-colors hover:text-accent hover:decoration-accent"
      >
        Explore services →
      </a>
    </div>

    <div class="grid grid-cols-1 gap-5 md:grid-cols-2">
      {
        services.map((service) => (
          <div class="rounded-[2px] border border-line bg-surface p-6 transition-colors hover:border-line-strong">
            <p class="font-mono text-xs text-accent">{service.index} //</p>
            <h3 class="mt-2 font-display text-xl font-semibold uppercase tracking-[0.02em] text-ink">
              {service.title}
            </h3>
            <p class="mt-2.5 text-sm leading-relaxed text-muted">
              {service.summary}
            </p>
            <div class="mt-4 flex flex-wrap gap-1.5">
              {service.tools.map((tool) => (
                <span class="rounded-[2px] border border-line bg-subtle px-2 py-0.5 font-mono text-[11px] text-metal">
                  {tool}
                </span>
              ))}
            </div>
          </div>
        ))
      }
    </div>
  </section>

  <!-- Closing CTA -->
  <section class="mx-auto max-w-5xl px-6 pt-20 sm:pt-24">
    <div class="flex flex-col justify-between gap-6 rounded-[2px] border border-line-strong border-l-2 border-l-accent bg-surface p-8 sm:p-10 md:flex-row md:items-center">
      <div>
        <p class="font-mono text-xs uppercase tracking-[0.16em] text-accent">
          Next Step
        </p>
        <h2 class="mt-2 font-display text-2xl font-semibold uppercase tracking-[0.02em] text-ink sm:text-3xl">
          Need a Senior SDET or resilient automation suite?
        </h2>
        <p class="mt-2 max-w-xl text-sm leading-relaxed text-muted">
          Based in {profile.location}, working remotely in US business hours. Reach out directly or grab my latest resume.
        </p>
      </div>
      <div class="flex shrink-0 flex-wrap gap-3">
        <a
          href="/contact"
          class="inline-flex items-center gap-2 rounded-[2px] bg-accent px-5 py-2.5 font-mono text-xs font-medium uppercase tracking-wider text-paper transition-colors hover:bg-ink"
        >
          <span>Get in touch</span>
          <span aria-hidden="true">→</span>
        </a>
        <a
          href={`mailto:${profile.email}`}
          class="inline-flex items-center rounded-[2px] border border-line-strong px-4 py-2.5 font-mono text-xs text-metal transition-colors hover:border-metal hover:text-ink"
        >
          {profile.email}
        </a>
      </div>
    </div>
  </section>
</Layout>
