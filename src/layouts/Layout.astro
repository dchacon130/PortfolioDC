---
import "../styles/global.css";
import Menu from "../components/Menu.astro";
import Footer from "../components/Footer.astro";
import { getProfile } from "../data/profile";
import { getUiCopy } from "../i18n/ui";
import { getAlternatePath, type Locale } from "../i18n/utils";

interface Props {
  locale?: Locale;
  title?: string;
  description?: string;
}

const {
  locale = "en",
  title,
  description,
} = Astro.props;

const profile = getProfile(locale);
const ui = getUiCopy(locale);

const resolvedTitle = title ?? profile.seo.defaultTitle;
const resolvedDescription = description ?? profile.seo.defaultDescription;
const fullTitle =
  resolvedTitle === profile.seo.defaultTitle
    ? resolvedTitle
    : `${resolvedTitle} — ${profile.name}`;

const canonicalUrl = new URL(Astro.url.pathname, profile.seo.siteUrl).href;
const enUrl = new URL(getAlternatePath(Astro.url.pathname, "en"), profile.seo.siteUrl).href;
const esUrl = new URL(getAlternatePath(Astro.url.pathname, "es"), profile.seo.siteUrl).href;
const ogImageUrl = new URL(profile.seo.ogImage, profile.seo.siteUrl).href;
const ogLocale = locale === "es" ? "es_CO" : "en_US";
const { cloudflareBeaconToken, plausibleDomain } = profile.analytics;
---

<!doctype html>
<html lang={locale} data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#0B0B0C" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" hreflang="en" href={enUrl} />
    <link rel="alternate" hreflang="es" href={esUrl} />
    <link rel="alternate" hreflang="x-default" href={enUrl} />
    <meta name="generator" content={Astro.generator} />

    <!-- Prevent theme flash: defaults to Heavy Metal Dark unless visitor chose light -->
    <script is:inline>
      (function () {
        try {
          const saved = localStorage.getItem("portfolio-theme");
          if (saved === "light" || saved === "dark") {
            document.documentElement.dataset.theme = saved;
            const meta = document.querySelector('meta[name="theme-color"]');
            if (meta) meta.setAttribute("content", saved === "light" ? "#ECECEE" : "#0B0B0C");
          }
        } catch {}
      })();
    </script>

    <title>{fullTitle}</title>
    <meta name="description" content={resolvedDescription} />
    <meta name="author" content={profile.fullName} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={resolvedDescription} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:site_name" content={profile.name} />

    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={resolvedDescription} />
    <meta name="twitter:image" content={ogImageUrl} />

    <!-- Typography: Oswald (Display) + Plus Jakarta Sans (Body) + IBM Plex Mono (Specs) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&family=Oswald:wght@500;600;700&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />

    <!-- Optional Privacy-First Analytics (enabled only when configured in src/data/profile.ts) -->
    {
      cloudflareBeaconToken && (
        <script
          defer
          src="https://static.cloudflareinsights.com/beacon.min.js"
          data-cf-beacon={JSON.stringify({ token: cloudflareBeaconToken })}
        />
      )
    }
    {
      plausibleDomain && (
        <script
          defer
          data-domain={plausibleDomain}
          src="https://plausible.io/js/script.js"
        />
      )
    }
  </head>
  <body class="bg-paper text-ink selection:bg-accent selection:text-paper">
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-[100] focus:bg-accent focus:px-4 focus:py-2 focus:font-mono focus:text-xs focus:font-semibold focus:text-paper"
    >
      {ui.skipToContent}
    </a>

    <Menu locale={locale} />

    <main id="main-content" class="flex-1">
      <slot />
    </main>

    <Footer locale={locale} />
  </body>
</html>
